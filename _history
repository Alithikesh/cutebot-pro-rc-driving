d name=\"NUM\">0</field></shadow><block type=\"argument_reporter_string\"><field name=\"VALUE\">command</field></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"text\"><field name=\"TEXT\">introduction</field></block></value></block></value><statement name=\"DO6\"><block type=\"CutebotPro_pwmCruiseControl\"><value name=\"speedL\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><value name=\"speedR\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><next><block type=\"CutebotPro_stopImmediately\"><field name=\"CutebotProMotors\">CutebotProMotors.ALL</field><next><block type=\"billy_say\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">Hello</field></shadow></value><next><block type=\"billy_say\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">My name is Ryder</field></shadow></value><next><block type=\"CutebotPro_extendServoControl\"><field name=\"ServoType\">ServoType.Servo180</field><field name=\"CutebotProServoIndex\">CutebotProServoIndex.S1</field><value name=\"angle\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><next><block type=\"CutebotPro_extendServoControl\"><field name=\"ServoType\">ServoType.Servo180</field><field name=\"CutebotProServoIndex\">CutebotProServoIndex.S1</field><value name=\"angle\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><next><block type=\"servoservosetangle\"><field name=\"servo\">servos.P0</field><value name=\"degrees\"><shadow type=\"protractorPicker\"><field name=\"angle\">90</field></shadow></value><next><block type=\"servoservosetangle\"><field name=\"servo\">servos.P0</field><value name=\"degrees\"><shadow type=\"protractorPicker\"><field name=\"angle\">0</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></statement></block></xml>","main.ts":"","README.md":"","main.py":"function autopilot_mode () {\n    sonar = CutebotPro.ultrasonic(SonarUnit.Inches)\n    if (sonar > 2 && sonar < 20) {\n        strip.showColor(neopixel.colors(NeoPixelColors.Red))\n        CutebotPro.colorLight(CutebotProRGBLight.RGBA, 0xff0000)\n        // Turn left to avoid obstacle\n        CutebotPro.trolleySteering(CutebotProTurn.Left, 180)\n    } else {\n        strip.showColor(neopixel.colors(NeoPixelColors.Green))\n        CutebotPro.colorLight(CutebotProRGBLight.RGBA, 0x00ff00)\n        // Drive forward\n        CutebotPro.pwmCruiseControl(30, 30)\n    }\n}\n// This is the recieve string part where it gets the instruction from the Joystick:bit.\nradio.onReceivedString(function (receivedString) {\n    if (receivedString == \"autopilot_on\") {\n        billy.say(\"autopilot mode on\")\n        autopilot_enabled = true\n        strip.showColor(neopixel.colors(NeoPixelColors.White))\n        CutebotPro.colorLight(CutebotProRGBLight.RGBA, 0xff9da5)\n    } else if (receivedString == \"autopilot_off\") {\n        billy.say(\"manual mode enabled\")\n        autopilot_enabled = false\n        strip.showColor(neopixel.colors(NeoPixelColors.Blue))\n        CutebotPro.colorLight(CutebotProRGBLight.RGBA, 0x0000ff)\n        CutebotPro.pwmCruiseControl(0, 0)\n    } else if (!(autopilot_enabled)) {\n        manual_mode(receivedString)\n    }\n})\n// Write this code for manual mode version which means you can control it.\nfunction manual_mode (command: string) {\n    if (command == \"forward\") {\n        strip.showColor(neopixel.colors(NeoPixelColors.Yellow))\n        CutebotPro.fullSpeedAhead()\n    } else if (command == \"backward\") {\n        strip.showColor(neopixel.colors(NeoPixelColors.White))\n        CutebotPro.fullAstern()\n    } else if (command == \"right\") {\n        strip.showColor(neopixel.colors(NeoPixelColors.Purple))\n        CutebotPro.pwmCruiseControl(30, -30)\n    } else if (command == \"left\") {\n        strip.showColor(neopixel.colors(NeoPixelColors.Yellow))\n        CutebotPro.pwmCruiseControl(-30, 30)\n    } else if (command == \"stop\") {\n        strip.showColor(neopixel.colors(NeoPixelColors.Blue))\n        CutebotPro.pwmCruiseControl(0, 0)\n    } else if (command == \"deliver\") {\n        CutebotPro.pwmCruiseControl(0, 0)\n        CutebotPro.stopImmediately(CutebotProMotors.ALL)\n        billy.say(\"Take this item\")\n        basic.showString(\"Take this item.\")\n        CutebotPro.colorLight(CutebotProRGBLight.RGBR, 0x00ffff)\n        strip.showColor(neopixel.colors(NeoPixelColors.Indigo))\n        CutebotPro.colorLight(CutebotProRGBLight.RGBL, 0x0000ff)\n        strip.showColor(neopixel.colors(NeoPixelColors.Violet))\n    } else if (command == \"introduction\") {\n        CutebotPro.pwmCruiseControl(0, 0)\n        CutebotPro.stopImmediately(CutebotProMotors.ALL)\n        billy.say(\"Hello\")\n        billy.say(\"My name is Ryder\")\n        CutebotPro.extendServoControl(ServoType.Servo360, CutebotProServoIndex.S1, 0)\n    }\n}\nlet autopilot_enabled = false\nlet sonar = 0\nlet strip: neopixel.Strip = null\nbilly.voicePreset(BillyVoicePreset.Dalek)\nbilly.say(\"Hello\")\nbilly.say(\"My name is Ryder\")\nradio.setGroup(3)\nstrip = neopixel.create(DigitalPin.P15, 24, NeoPixelMode.RGB)\nstrip.setMatrixWidth(10000)\n// Check if on autopilot, and activate autopilot mode.0\nbasic.forever(function () {\n    if (autopilot_enabled) {\n        autopilot_mode()\n    }\n})\n","pxt.json":"{\n    \"name\": \"Cutebot Pro RC driving\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"pxt-cutebotpro\": \"github:elecfreaks/pxt-cutebot-pro#v2.1.2\",\n        \"radio-broadcast\": \"*\",\n        \"Billy\": \"github:adamish/pxt-billy#v0.0.25\",\n        \"servo\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n  