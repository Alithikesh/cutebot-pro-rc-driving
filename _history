0, 30)\n\n    elif receivedString == \"right\":\n        is_stopped = False\n        CutebotPro.pwm_cruise_control(30, -30)\n\n    elif receivedString == \"stop\":\n        is_stopped = True\n        CutebotPro.pwm_cruise_control(0, 0)\n\n\nradio.on_received_string(on_received_string)\n\n\ndef on_forever():\n    obstacle_avoidance()\n\nbasic.forever(on_forever)"}]},{"timestamp":1781904020453,"editorVersion":"8.0.22","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":11210,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"_DHl5=Mc]-PT_%K_eusG\">is_stopped</variable><variable id=\"`)w4DL4#xwrq7zK-fj}a\">strip</variable><variable id=\"t^7oPwBr)(p3*oA_=niL\">sonar</variable></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"`)w4DL4#xwrq7zK-fj}a\">strip</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"neopixel_create\"><field name=\"pin\">DigitalPin.P15</field><field name=\"mode\">NeoPixelMode.RGB</field><value name=\"numleds\"><shadow type=\"math_number\"><field name=\"NUM\">2</field></shadow></value></block></value><next><block type=\"radio_set_group\"><value name=\"ID\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"255\" precision=\"0\"></mutation><field name=\"SLIDER\">3</field></shadow></value></block></next></block></statement></block><block type=\"device_forever\" x=\"822\" y=\"20\"><statement name=\"HANDLER\"><block type=\"function_call\"><mutation name=\"obstacle_avoidance\" functionid=\"Q$rc8Cx[Op)PEZ|4M]d6\"></mutation></block></statement></block><block type=\"radio_on_string_drag\" x=\"1101\" y=\"20\"><value name=\"HANDLER_DRAG_PARAM_receivedString\"><block type=\"argument_reporter_string\" deletable=\"false\"><field name=\"VALUE\">receivedString</field></block></value><statement name=\"HANDLER\"><block type=\"contro