and</field></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"text\"><field name=\"TEXT\">left</field></block></value></block></value><statement name=\"DO3\"><block type=\"neopixel_set_strip_color\"><value name=\"strip\"><block type=\"variables_get\"><field name=\"VAR\" id=\"N,qh=tiO{uyh$GI!,@yw\">strip</field></block></value><value name=\"rgb\"><shadow type=\"neopixel_colors\"><field name=\"color\">NeoPixelColors.Yellow</field></shadow></value><next><block type=\"CutebotPro_pwmCruiseControl\"><value name=\"speedL\"><shadow type=\"math_number\"><field name=\"NUM\">-30</field></shadow></value><value name=\"speedR\"><shadow type=\"math_number\"><field name=\"NUM\">30</field></shadow></value></block></next></block></statement><value name=\"IF4\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></shadow><block type=\"logic_compare\"><field name=\"OP\">EQ</field><value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"argument_reporter_string\"><field name=\"VALUE\">command</field></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"text\"><field name=\"TEXT\">stop</field></block></value></block></value><statement name=\"DO4\"><block type=\"neopixel_set_strip_color\"><value name=\"strip\"><block type=\"variables_get\"><field name=\"VAR\" id=\"N,qh=tiO{uyh$GI!,@yw\">strip</field></block></value><value name=\"rgb\"><shadow type=\"neopixel_colors\"><field name=\"color\">NeoPixelColors.Blue</field></shadow></value><next><block type=\"CutebotPro_pwmCruiseControl\"><value name=\"speedL\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><value name=\"speedR\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value></block></next></block></statement></block></statement></block></xml>","main.ts":"","README.md":"","main.py":"autopilot_enabled = False\nsonar = 0\nstrip: neopixel.Strip = None\n\nradio.set_group(3)\nstrip = neopixel.create(DigitalPin.P15, 24, NeoPixelMode.RGB)\n\ndef autopilot_mode():\n    global sonar\n\n    sonar = CutebotPro.ultrasonic(SonarUnit.INCHES)\n\n    if sonar > 2 and sonar < 20:\n        strip.show_color(neopixel.colors(NeoPixelColors.RED))\n        CutebotPro.color_light(CutebotProRGBLight.RGBA, 0xff0000)\n\n        # Turn left to avoid obstacle\n        CutebotPro.trolley_steering(\n            CutebotProTurn.LEFT,\n            180\n        )\n    else:\n        strip.show_color(neopixel.colors(NeoPixelColors.GREEN))\n        CutebotPro.color_light(CutebotProRGBLight.RGBA, 0x00ff00)\n\n        # Drive forward\n        CutebotPro.pwm_cruise_control(30, 30)\n\ndef manual_mode(command):\n    if command == \"forward\":\n        strip.show_color(neopixel.colors(NeoPixelColors.GREEN))\n        CutebotPro.full_speed_ahead()\n\n    elif command == \"backward\":\n        strip.show_color(neopixel.colors(NeoPixelColors.RED))\n        CutebotPro.full_astern()\n\n    elif command == \"right\":\n        strip.show_color(neopixel.colors(NeoPixelColors.PURPLE))\n        CutebotPro.pwm_cruise_control(30, -30)\n\n    elif command == \"left\":\n        strip.show_color(neopixel.colors(NeoPixelColors.YELLOW))\n        CutebotPro.pwm_cruise_control(-30, 30)\n\n    elif command == \"stop\":\n        strip.show_color(neopixel.colors(NeoPixelColors.BLUE))\n        CutebotPro.pwm_cruise_control(0, 0)\n\ndef on_received_string(receivedString):\n    global autopilot_enabled\n\n    if receivedString == \"autopilot_on\":\n        autopilot_enabled = True\n\n        strip.show_color(neopixel.colors(NeoPixelColors.WHITE))\n        CutebotPro.color_light(\n            CutebotProRGBLight.RGBA,\n            0xffffff\n        )\n\n    elif receivedString == \"autopilot_off\":\n        autopilot_enabled = False\n\n        strip.show_color(neopixel.colors(NeoPixelColors.BLUE))\n        CutebotPro.color_light(\n            CutebotProRGBLight.RGBA,\n            0x0000ff\n        )\n\n        CutebotPro.pwm_cruise_control(0, 0)\n\n    elif not autopilot_enabled:\n        manual_mode(receivedString)\n\nradio.on_received_string(on_received_string)\n\ndef on_forever():\n    if autopilot_enabled:\n        autopilot_mode()\n\nbasic.forever(on_forever)","pxt.json":"{\n    \"name\": \"Cutebot Pro RC driving\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"pxt-cutebotpro\": \"github:elecfreaks/pxt-cutebot-pro#v2.1.2\",\n        \"radio-broadcast\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}},{"timestamp":1782503832428,"editorVersion":"8.0.22","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"2|SF4Nn[8:S~%(gJDvg3\">sonar</variable><variable id=\"+PIYA;[IW){v-4vo.;J3\">strip</variable><variable id=\"yx;BT=R^p^{a!=yPu5Fu\">autopilot_enabled</variable></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"radio_set_group\"><value name=\"ID\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"255\" precision=\"0\"></mutation><field name=\"SLIDER\">3</field></shadow></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\"+PIYA;[IW){v-4vo.;J3\">strip</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"neopixel_create\"><field name=\"pin\">DigitalPin.P15</field><field name=\"mode\">NeoPixelMode.RGB</field><value name=\"numleds\"><shadow type=\"math_number\"><field name=\"NUM\">24</field></shadow></value></block></value><next><block type=\"neopixel_set_matrix_width\"><value name=\"strip\"><block type=\"variables_get\"><field name=\"VAR\" id=\"+PIYA;[IW){v-4vo.;J3\">strip</field></block></v