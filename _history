eld></shadow></value><next><block type=\"CutebotPro_pwmCruiseControl\"><value name=\"speedL\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><value name=\"speedR\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value></block></next></block></statement></block></statement></block></xml>","main.ts":"","README.md":"","main.py":"def autopilot_mode():\n    global sonar\n    sonar = CutebotPro.ultrasonic(SonarUnit.INCHES)\n    if sonar > 2 and sonar < 20:\n        strip.show_color(neopixel.colors(NeoPixelColors.RED))\n        CutebotPro.color_light(CutebotProRGBLight.RGBA, 0xff0000)\n        # Turn left to avoid obstacle\n        CutebotPro.trolley_steering(CutebotProTurn.LEFT, 180)\n    else:\n        strip.show_color(neopixel.colors(NeoPixelColors.GREEN))\n        CutebotPro.color_light(CutebotProRGBLight.RGBA, 0x00ff00)\n        # Drive forward\n        CutebotPro.pwm_cruise_control(30, 30)\n\ndef on_received_string(receivedString):\n    global autopilot_enabled\n    if receivedString == \"autopilot_on\":\n        autopilot_enabled = True\n        strip.show_color(neopixel.colors(NeoPixelColors.WHITE))\n        CutebotPro.color_light(CutebotProRGBLight.RGBA, 0xffffff)\n    elif receivedString == \"autopilot_off\":\n        autopilot_enabled = False\n        strip.show_color(neopixel.colors(NeoPixelColors.BLUE))\n        CutebotPro.color_light(CutebotProRGBLight.RGBA, 0x0000ff)\n        CutebotPro.pwm_cruise_control(0, 0)\n    elif not (autopilot_enabled):\n        manual_mode(receivedString)\nradio.on_received_string(on_received_string)\n\ndef manual_mode(command: str):\n    if command == \"forward\":\n        strip.show_color(neopixel.colors(NeoPixelColors.GREEN))\n        CutebotPro.full_speed_ahead()\n    elif command == \"backward\":\n        strip.show_color(neopixel.colors(NeoPixelColors.RED))\n        CutebotPro.full_astern()\n    elif command == \"right\":\n        strip.show_color(neopixel.colors(NeoPixelColors.PURPLE))\n        CutebotPro.pwm_cruise_control(30, -30)\n    elif command == \"left\":\n        strip.show_color(neopixel.colors(NeoPixelColors.YELLOW))\n        CutebotPro.pwm_cruise_control(-30, 30)\n    elif command == \"stop\":\n        strip.show_color(neopixel.colors(NeoPixelColors.BLUE))\n        CutebotPro.pwm_cruise_control(0, 0)\nautopilot_enabled = False\nsonar = 0\nstrip: neopixel.Strip = None\nradio.set_group(3)\nstrip = neopixel.create(DigitalPin.P15, 24, NeoPixelMode.RGB)\n\ndef on_forever():\n    if autopilot_enabled:\n        autopilot_mode()\nbasic.forever(on_forever)\n","pxt.json":"{\n    \"name\": \"Cutebot Pro RC driving\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"pxt-cutebotpro\": \"github:elecfreaks/pxt-cutebot-pro#v2.1.2\",\n        \"radio-broadcast\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}},{"timestamp":1782333729390,"editorVersion":"8.0.22","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"KsaT9Y?z2=}HzZVWY}{Q\">sonar</variable><variable id=\"N,qh=tiO{uyh$GI!,@yw\">strip</variable><variable id=\"+c4iA-.TEU.U9]Go2psO\">autopilot_enabled</variable></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"radio_set_group\"><value name=\"ID\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"255\" precision=\"0\"></mutation><field name=\"SLIDER\">3</field></shadow></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\"N,qh=tiO{uyh$GI!,@yw\">strip</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"neopixel_create\"><field name=\"pin\">DigitalPin.P15</field><field name=\"mode\">NeoPixelMode.RGB</field><value name=\"num