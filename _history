botPro.color_light(CutebotProRGBLight.RGBA, 0xff0000)\n        # Turn left to avoid obstacle\n        CutebotPro.trolley_steering(CutebotProTurn.LEFT, 180)\n    else:\n        strip.show_color(neopixel.colors(NeoPixelColors.GREEN))\n        CutebotPro.color_light(CutebotProRGBLight.RGBA, 0x00ff00)\n        # Drive forward\n        CutebotPro.pwm_cruise_control(30, 30)\n# This is the recieve string part where it gets the instruction from the Joystick:bit.\n\ndef on_received_string(receivedString):\n    global autopilot_enabled\n    if receivedString == \"autopilot_on\":\n        autopilot_enabled = True\n        strip.show_color(neopixel.colors(NeoPixelColors.WHITE))\n        CutebotPro.color_light(CutebotProRGBLight.RGBA, 0xff9da5)\n    elif receivedString == \"autopilot_off\":\n        autopilot_enabled = False\n        strip.show_color(neopixel.colors(NeoPixelColors.BLUE))\n        CutebotPro.color_light(CutebotProRGBLight.RGBA, 0x0000ff)\n        CutebotPro.pwm_cruise_control(0, 0)\n    elif not (autopilot_enabled):\n        manual_mode(receivedString)\nradio.on_received_string(on_received_string)\n\n# Write this code for manual mode version which means you can control it.\ndef manual_mode(command: str):\n    if command == \"forward\":\n        strip.show_color(neopixel.colors(NeoPixelColors.YELLOW))\n        CutebotPro.full_speed_ahead()\n    elif command == \"backward\":\n        strip.show_color(neopixel.colors(NeoPixelColors.WHITE))\n        CutebotPro.full_astern()\n    elif command == \"right\":\n        strip.show_color(neopixel.colors(NeoPixelColors.PURPLE))\n        CutebotPro.pwm_cruise_control(30, -30)\n    elif command == \"left\":\n        strip.show_color(neopixel.colors(NeoPixelColors.YELLOW))\n        CutebotPro.pwm_cruise_control(-30, 30)\n    elif command == \"stop\":\n        strip.show_color(neopixel.colors(NeoPixelColors.BLUE))\n        CutebotPro.pwm_cruise_control(0, 0)\n    elif command == \"deliver\":\n        basic.show_string(\"Take this item.\")\n        CutebotPro.color_light(CutebotProRGBLight.RGBR, 0x00ffff)\n        strip.show_color(neopixel.colors(NeoPixelColors.INDIGO))\n        CutebotPro.color_light(CutebotProRGBLight.RGBL, 0x0000ff)\n        strip.show_color(neopixel.colors(NeoPixelColors.VIOLET))\nautopilot_enabled = False\nsonar = 0\nstrip: neopixel.Strip = None\nradio.set_group(3)\nstrip = neopixel.create(DigitalPin.P15, 24, NeoPixelMode.RGB)\nstrip.set_matrix_width(10000)\n# Check if on autopilot, and activate autopilot mode.0\n\ndef on_forever():\n    if autopilot_enabled:\n        autopilot_mode()\nbasic.forever(on_forever)\n","pxt.json":"{\n    \"name\": \"Cutebot Pro RC driving\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"pxt-cutebotpro\": \"github:elecfreaks/pxt-cutebot-pro#v2.1.2\",\n        \"radio-broadcast\": \"*\",\n        \"Billy\": \"github:adamish/pxt-billy#v0.0.25\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}},{"timestamp":1783030790612,"editorVersion":"8.0.22","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"2|SF4Nn[8:S~%(gJDvg3\">sonar</variable><variable id=\"+PIYA;[IW){v-4vo.;J3\">strip</variable><variable id=\"yx;BT=R^p^{a!=yPu5Fu\">autopilot_enabled</variable></variables><block type=\"function_definition\" x=\"1391\" y=\"-501\"><mutation name=\"autopilot_mode\" functionid=\"U9IRB,Rn-cY4[xRF;~#b\"></mutation><field name=\"function_name\">autopilot_mode</field><statement name=\"STACK\"><block type=\"variables_set\"><field name=\"VAR\" id=\"2|SF4Nn[8:S~%(gJDvg3\">sonar</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"ultrasonic\"><field name=\"SonarUnit\">SonarUnit.Inches</field></block></value><next><block type=\"con